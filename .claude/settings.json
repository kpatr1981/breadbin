{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/claude-sync.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/claude-sync.sh\"",
            "timeout": 30,
            "statusMessage": "Syncing with GitHub..."
          }
        ]
      }
    ]
  }
}
